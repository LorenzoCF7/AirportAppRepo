# ===================================
# AIRPORT APP - VARIABLES DE ENTORNO
# ===================================
# Copia este archivo como .env y rellena tus valores.
# El .env real nunca se sube a git.

# MapTiler API Key — mapa interactivo
# Obtén tu key gratis en: https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# AviationStack API Key — vuelos en tiempo real (mapa)
# Obtén tu key gratis en: https://aviationstack.com/
# Plan Free: 100 req/mes (la app cachea para no gastarlos)
VITE_AVIATION_API_KEY=your_aviationstack_api_key_here

# Amadeus API Credentials — ofertas de vuelos (opcional)
# Obtén tus credenciales en: https://developers.amadeus.com/
# Plan Test: 2000 req/mes gratuitas
VITE_AMADEUS_CLIENT_ID=your_amadeus_client_id_here
VITE_AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Stripe — clave pública (frontend)
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
# Usa claves de TEST (pk_test_...) para desarrollo
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here

# Vuelos mock — pon false para usar AviationStack real
VITE_USE_MOCK_FLIGHTS=false
