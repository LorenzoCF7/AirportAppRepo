# ===================================
# AIRPORT APP BACKEND - VARIABLES DE ENTORNO
# ===================================
# Define estas variables en tu servidor o en un archivo .env
# que cargues antes de arrancar Spring Boot.
# Nunca subas credenciales reales a git.

# Stripe — clave secreta (backend)
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
# Usa claves de TEST (sk_test_...) para desarrollo
# Si está vacía, el backend activa modo demo automáticamente
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# AviationStack API Key — vuelos en tiempo real
# Obtén tu key gratis en: https://aviationstack.com/
# Si está vacía, el backend usa datos mock automáticamente
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Amadeus API Credentials — ofertas de vuelos (opcional)
# Obtén tus credenciales en: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Anthropic Claude API — recomendaciones IA (opcional)
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Groq API — IA gratuita alternativa (opcional)
# Obtén tu key gratis en: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_key_here
